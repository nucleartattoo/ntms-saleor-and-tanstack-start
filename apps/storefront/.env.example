# Public Saleor GraphQL endpoint. No admin token belongs in this file.
SALEOR_API_ENDPOINT="https://your-saleor.example.com/graphql/"
VENDURE_SHOP_API_ENDPOINT="http://localhost:3000/shop-api"
SALEOR_CHANNEL="default-channel"
SALEOR_ROOT_CATEGORY_SLUG="__root__"
SALEOR_ALLOW_UNSAFE_PAYMENT_GATEWAYS="disabled"
SALEOR_ENABLED_PAYMENT_GATEWAYS=""

VITE_STOREFRONT_BACKEND="saleor"
VITE_COMPANY_NAME="Your Store"
VITE_SITE_NAME="Your Store"
VITE_TWITTER_CREATOR="@example"
VITE_TWITTER_SITE="@example"
VITE_PARENT_ID="1"
VITE_WEBSITE_URL="http://localhost:3010"
VITE_SEARCH_INDEXING="disabled"
VITE_STRIPE_PUBLISHABLE_KEY=""
VITE_APP_BUILD_VERSION="local"
APP_SERVICE_NAME="saleor-ntms-tanstack"
SESSION_SECRET="replace-with-a-random-32-character-secret"
NODE_ENV="development"
