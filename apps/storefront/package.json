{
  "name": "saleor-ntms-tanstack",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3002",
    "build": "vite build && npm run check:bundle",
    "build:client": "vite build",
    "build:cloudflare": "DEPLOY_TARGET=cloudflare vite build",
    "deploy:cloudflare": "npm run build:cloudflare && wrangler deploy",
    "serve": "node server.js",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify": "gql.tada check --level error && biome check && tsc --noEmit && npm run build",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check",
    "check:bundle": "node scripts/check-client-bundle-budget.mjs",
    "smoke:navigation": "node scripts/smoke-navigation.mjs",
    "smoke:ntms-saleor-variants": "node scripts/smoke-saleor-variant-catalog.mjs",
    "smoke:ntms-saleor-checkout": "node scripts/smoke-ntms-saleor-checkout.mjs",
    "build:image": "docker build -t saleor-ntms-tanstack ."
  },
  "dependencies": {
    "@graphql-typed-document-node/core": "^3.2.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.3",
    "@stripe/react-stripe-js": "^6.6.0",
    "@stripe/stripe-js": "^9.8.0",
    "@t3-oss/env-core": "^0.13.8",
    "@tailwindcss/vite": "^4.3.1",
    "@tanstack/react-form": "^1.23.8",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-router": "^1.132.0",
    "@tanstack/react-router-with-query": "^1.130.17",
    "@tanstack/react-start": "^1.132.0",
    "@unpic/react": "^1.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "gql.tada": "^1.8.13",
    "graphql": "^16.11.0",
    "lucide-react": "^0.544.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.0.6",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "@cloudflare/vite-plugin": "^1.54.6",
    "@playwright/test": "^1.61.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^27.0.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.2",
    "vite": "^8.0.16",
    "vitest": "^4.1.9",
    "wrangler": "^4.130.0"
  },
  "overrides": {
    "@opentelemetry/core": "2.8.0",
    "@opentelemetry/resources": "2.8.0",
    "@opentelemetry/sdk-trace-base": "2.8.0",
    "@opentelemetry/sdk-trace-node": "2.8.0",
